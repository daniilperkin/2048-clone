{
  "name": "2048-mine",
  "version": "1.0.0",
  "description": "A modernized 2048 fork with theme system, accessibility, single-file bundling, ESLint 10 + Prettier 3, and a Vitest suite.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "serve . -l 8080",
    "prestart": "node tools/generate-tiles.mjs",
    "build": "node build-bundle.js",
    "tiles": "node tools/generate-tiles.mjs",
    "icons": "node tools/make-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "compression": "^1.8.2",
    "minimatch": "^10.2.6"
  }
}
