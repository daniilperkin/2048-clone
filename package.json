{
  "name": "2048-mine",
  "version": "1.0.0",
  "description": "A small clone of 1024, based on Saming's 2048 (also a clone).",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "serve . -l 8080",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6"
  }
}
