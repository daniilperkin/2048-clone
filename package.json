{
  "name": "2048-clone",
  "version": "2.0.0",
  "description": "A modernized 2048 fork with theme system, accessibility, board sizes, local records, PWA support, single-file bundling, and a Vitest + Playwright suite.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "serve . -l 8080",
    "prestart": "node tools/generate-tiles.mjs",
    "build": "node build-bundle.js",
    "tiles": "node tools/generate-tiles.mjs",
    "icons": "node tools/make-icons.mjs",
    "lint": "eslint . --config config/eslint.config.js",
    "lint:fix": "eslint . --fix --config config/eslint.config.js",
    "lint:css": "stylelint \"style/**/*.css\" --config config/.stylelintrc.json",
    "format": "prettier --write . --config config/.prettierrc.json --ignore-path config/.prettierignore",
    "format:check": "prettier --check . --config config/.prettierrc.json --ignore-path config/.prettierignore",
    "test": "vitest run --config config/vitest.config.js",
    "coverage": "vitest run --config config/vitest.config.js --coverage",
    "typecheck": "tsc -p config/jsconfig.json",
    "test:e2e": "playwright test --config config/playwright.config.js",
    "verify": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "compression": "^1.8.2",
    "minimatch": "^10.2.6"
  }
}
